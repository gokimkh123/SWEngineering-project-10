# 찰칵부산 서버 환경변수 (NFR-07: 키는 서버에만, 이 파일을 복사한 .env는 저장소에 올리지 않음)
# 비워 두면 샘플 데이터·모의 AI로 동작한다.

# CP-18 장소 데이터
TOUR_API_KEY=          # 한국관광공사 TourAPI (공공데이터포털 일반 인증키, 디코딩 키)
BUSAN_API_KEY=         # 부산광역시 명소·맛집 정보 (공공데이터포털)
KAKAO_REST_KEY=        # 카카오 로컬 REST API 키

# CP-19 AI Gateway
VLM_PROVIDER=fake      # fake | ollama
VLM_MODEL=qwen2.5vl:7b
LLM_PROVIDER=fake      # fake | anthropic | gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FAKE_AI_LATENCY=1.2    # 모의 AI 응답 지연(초) — 진행률 화면 시연용

# 확신도 라우팅 임계값 (FR-04, PoC 후 조정)
MATCH_AUTO_THRESHOLD=0.8
MATCH_CHECK_THRESHOLD=0.5

# 장애 주입 (NFR-08 시스템 테스트): 예) FAULT_INJECT=kakao
FAULT_INJECT=

# 브라우저 카카오맵 JavaScript 키 (도메인 제한 필수, 비우면 OpenStreetMap)
VITE_KAKAO_JS_KEY=
