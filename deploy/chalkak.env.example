# 찰칵부산 배포 설정 예시. deploy/setup.sh 가 비밀값을 채워 deploy/chalkak.env 를 만든다(저장소에 올리지 않음).
# 값을 바꾼 뒤: docker compose up -d api worker   (터널은 그대로 → 공개 주소 유지)

# ---- 비밀값 (setup.sh 가 임의로 생성) ----
POSTGRES_PASSWORD=__생성됨__
REDIS_PASSWORD=__생성됨__
DATABASE_URL=postgresql+psycopg://chalkak:__생성됨__@postgres:5432/chalkak
REDIS_URL=redis://:__생성됨__@redis:6379/0

# ---- 공개 서비스 모드: API 문서·즉석 시연 여행 끄기, 오래된 여행 자동 삭제(일) ----
PUBLIC_MODE=1
RETENTION_DAYS=3
MAX_ACTIVE_JOBS=20
MAX_TRIPS_PER_DAY=20

# ---- AI: 이 PC의 GPU에서 Ollama로 실행하는 오픈소스 Qwen VL ----
VLM_PROVIDER=ollama
VLM_MODEL=qwen3.5:4b
VLM_TIMEOUT=180
MATCH_WORKERS=2
# 여행기 글쓰기: ollama(같은 Qwen 모델, 실패하면 템플릿) 또는 fake(공식 데이터 템플릿)
LLM_PROVIDER=ollama
LLM_TIMEOUT=240

# ---- 장소 데이터 API 키 (비우면 샘플 장소 40곳만 후보로 씀) ----
# 한국관광공사 TourAPI · 부산시 명소/맛집: 공공데이터포털(data.go.kr) 일반 인증키(Decoding)
TOUR_API_KEY=
BUSAN_API_KEY=
# 카카오 로컬 REST API 키 (developers.kakao.com)
KAKAO_REST_KEY=
